# Copy to secrets.yaml and fill in real values. Never commit secrets.yaml.
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Generate with: esphome or `openssl rand -base64 32`
api_key: "GENERATE_BASE64_32_BYTES"
ota_password: "GENERATE_RANDOM_PASSWORD"
fallback_hotspot_password: "GENERATE_RANDOM_PASSWORD"
